# Copy this file to .env and fill in real values.
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# For local (non-Docker) dev, pointing at Postgres running via `docker compose up postgres`:
DATABASE_URL=postgresql+asyncpg://careerforge:careerforge@localhost:5432/careerforge

# --- Auth (Phase 2) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider ---
# Option A: Ollama (local, free, no API key). Recommended for dev.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AUTO_PULL=true

# Option B: Anthropic Claude (requires API key)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6

# --- Embeddings (Phase 5) ---
EMBEDDING_PROVIDER=ollama          # "ollama" for production, "local" for tests (no Ollama needed)
EMBEDDING_MODEL=nomic-embed-text   # 384-dim, fast, free via Ollama
EMBEDDING_DIMENSIONS=384           # Must match the model. Update here if you switch models.

# --- RAG pipeline tuning (Phase 5) ---
RAG_CHUNK_SIZE=900          # Characters per chunk
RAG_CHUNK_OVERLAP=150       # Character overlap between adjacent chunks
RAG_TOP_K=6                 # Number of chunks retrieved per query
RAG_HISTORY_TURNS=6         # Number of past conversation turns injected into LLM context
RAG_IVFFLAT_PROBES=10      # pgvector search quality (higher = better recall, slower)

# --- Resume uploads (Phase 3) ---
UPLOAD_DIR=uploads/resumes
MAX_RESUME_FILE_SIZE_MB=5

# --- GitHub integration (Phase 6) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Web search / research agent (Phase 7) ---
SEARCH_API_KEY=

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

